<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen android:divider="@color/colorError"
  xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.preference.PreferenceCategory app:iconSpaceReserved="false" app:isPreferenceVisible="false" app:title="@string/localization">
        <androidx.preference.ListPreference app:defaultValue="en" app:enabled="true" app:entries="@array/entries_locale" app:entryValues="@array/entry_values_locale" app:iconSpaceReserved="false" app:isPreferenceVisible="false" app:key="key_locale" app:title="@string/app_language" app:useSimpleSummaryProvider="true" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory app:iconSpaceReserved="false" app:isPreferenceVisible="true" app:title="@string/appearance">
        <androidx.preference.ListPreference app:defaultValue="original" app:enabled="@bool/hasThemeSupport" app:entries="@array/entries_theme" app:entryValues="@array/entry_values_theme" app:iconSpaceReserved="false" app:isPreferenceVisible="true" app:key="key_theme" app:shouldDisableView="true" app:title="@string/theme" app:useSimpleSummaryProvider="true" />
        <androidx.preference.ListPreference app:defaultValue="s" app:enabled="true" app:entries="@array/entries_ui_mode" app:entryValues="@array/entry_values_ui_mode" app:iconSpaceReserved="false" app:key="key_ui_mode" app:title="@string/ui_mode" app:useSimpleSummaryProvider="true" />
        <androidx.preference.ListPreference app:defaultValue="USD" app:enabled="true" app:entries="@array/entries_currency_sign" app:entryValues="@array/entry_values_currency_sign" app:iconSpaceReserved="false" app:key="key_currency_sign" app:title="@string/currency_sign" app:useSimpleSummaryProvider="true" />
        <androidx.preference.ListPreference app:defaultValue="start" app:enabled="true" app:entries="@array/entries_currency_position" app:entryValues="@array/entry_values_currency_position" app:iconSpaceReserved="false" app:key="key_currency_position" app:title="@string/currency_position" app:useSimpleSummaryProvider="true" />
        <androidx.preference.ListPreference app:defaultValue="2" app:enabled="true" app:entries="@array/entries_decimal_place" app:entryValues="@array/entry_values_decimal_place" app:iconSpaceReserved="false" app:key="key_decimal_place" app:title="@string/decimal_place" app:useSimpleSummaryProvider="true" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory app:iconSpaceReserved="false" app:isPreferenceVisible="true" app:title="@string/security">
        <androidx.preference.Preference app:enabled="@bool/hasPassCodeSupport" app:iconSpaceReserved="false" app:isPreferenceVisible="true" app:key="key_pin_screen" app:summary="@string/summary_passcode_lock" app:title="@string/passcode_protection" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory app:iconSpaceReserved="false" app:title="@string/notification">
        <SwitchPreferenceCompat app:defaultValue="false" app:enabled="true" app:iconSpaceReserved="false" app:key="key_reminder_on" app:summary="@string/summary_reminder" app:title="@string/remind_everyday" />
        <androidx.preference.Preference app:enabled="true" app:iconSpaceReserved="false" app:isPreferenceVisible="true" app:key="key_notification_settings" app:title="@string/notification_settings" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory app:iconSpaceReserved="false" app:title="@string/about">
        <SwitchPreferenceCompat app:defaultValue="true" app:enabled="true" app:iconSpaceReserved="false" app:key="key_crash_report" app:summary="@string/summary_crash_reporting" app:title="@string/send_crash_and_usage_statistics" />
        <androidx.preference.Preference app:enabled="true" app:iconSpaceReserved="false" app:isPreferenceVisible="true" app:key="key_privacy_policy" app:title="@string/privacy_policy" />
        <androidx.preference.Preference app:enabled="true" app:iconSpaceReserved="false" app:isPreferenceVisible="true" app:key="key_about_the_app" app:summary="@string/summary_about_the_app" app:title="@string/app_name_with_version" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
